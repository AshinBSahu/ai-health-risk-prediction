{
  "_meta": {
    "description": "Clinical reference ranges and underwriting risk categories used by the Step 7 LangGraph underwriting agent. Ranges are standard published clinical thresholds; risk categories are simplified for demonstration.",
    "disclaimer": "Reference ranges from published guidelines (ADA, ACC/AHA, NCEP ATP III, WHO). Underwriting risk categories/thresholds are illustrative for this academic project and do NOT reflect any real insurer's proprietary rules."
  },
  "clinical_ranges": {
    "AGE": {
      "name": "Age",
      "unit": "years",
      "bands": [
        {"label": "young adult", "min": 18, "max": 40},
        {"label": "middle-aged", "min": 40, "max": 60},
        {"label": "older adult", "min": 60, "max": 75},
        {"label": "elderly", "min": 75, "max": null}
      ],
      "source": "General demographic banding"
    },
    "BMXBMI": {
      "name": "Body Mass Index (BMI)",
      "unit": "kg/m^2",
      "bands": [
        {"label": "underweight", "min": 0, "max": 18.5},
        {"label": "normal", "min": 18.5, "max": 25},
        {"label": "overweight", "min": 25, "max": 30},
        {"label": "obese", "min": 30, "max": null}
      ],
      "source": "WHO Classification"
    },
    "BP_SYS_MEAN": {
      "name": "Systolic Blood Pressure",
      "unit": "mmHg",
      "bands": [
        {"label": "normal", "min": 0, "max": 120},
        {"label": "elevated", "min": 120, "max": 130},
        {"label": "hypertension stage 1", "min": 130, "max": 140},
        {"label": "hypertension stage 2", "min": 140, "max": null}
      ],
      "source": "ACC/AHA 2017 Guidelines"
    },
    "BP_DIA_MEAN": {
      "name": "Diastolic Blood Pressure",
      "unit": "mmHg",
      "bands": [
        {"label": "normal", "min": 0, "max": 80},
        {"label": "hypertension stage 1", "min": 80, "max": 90},
        {"label": "hypertension stage 2", "min": 90, "max": null}
      ],
      "source": "ACC/AHA 2017 Guidelines"
    },
    "LBXTC": {
      "name": "Total Cholesterol",
      "unit": "mg/dL",
      "bands": [
        {"label": "desirable", "min": 0, "max": 200},
        {"label": "borderline high", "min": 200, "max": 240},
        {"label": "high", "min": 240, "max": null}
      ],
      "source": "NCEP ATP III"
    },
    "LBDHDD": {
      "name": "HDL Cholesterol",
      "unit": "mg/dL",
      "bands": [
        {"label": "low (higher risk)", "min": 0, "max": 40},
        {"label": "normal", "min": 40, "max": 60},
        {"label": "high (protective)", "min": 60, "max": null}
      ],
      "source": "NCEP ATP III"
    },
    "LBXGH": {
      "name": "Hemoglobin A1c (HbA1c)",
      "unit": "%",
      "bands": [
        {"label": "normal", "min": 0, "max": 5.7},
        {"label": "prediabetic", "min": 5.7, "max": 6.5},
        {"label": "diabetic", "min": 6.5, "max": null}
      ],
      "source": "ADA 2023 Standards of Care"
    },
    "LBXSGL": {
      "name": "Fasting Glucose",
      "unit": "mg/dL",
      "bands": [
        {"label": "normal", "min": 0, "max": 100},
        {"label": "prediabetic", "min": 100, "max": 126},
        {"label": "diabetic", "min": 126, "max": null}
      ],
      "source": "ADA 2023 Standards of Care"
    },
    "LBXSCR": {
      "name": "Serum Creatinine",
      "unit": "mg/dL",
      "bands": [
        {"label": "normal", "min": 0, "max": 1.3},
        {"label": "mildly elevated", "min": 1.3, "max": 2.0},
        {"label": "elevated (renal impairment)", "min": 2.0, "max": null}
      ],
      "source": "General clinical laboratory reference"
    },
    "LBXSUA": {
      "name": "Serum Uric Acid",
      "unit": "mg/dL",
      "bands": [
        {"label": "normal", "min": 0, "max": 7.0},
        {"label": "elevated (hyperuricemia)", "min": 7.0, "max": null}
      ],
      "source": "General clinical laboratory reference"
    },
    "LBXSAL": {
      "name": "Serum Albumin",
      "unit": "g/dL",
      "bands": [
        {"label": "low (poor nutrition/illness)", "min": 0, "max": 3.5},
        {"label": "normal", "min": 3.5, "max": 5.5},
        {"label": "high", "min": 5.5, "max": null}
      ],
      "source": "General clinical laboratory reference"
    },
    "URXUMA": {
      "name": "Urine Albumin",
      "unit": "mg/L",
      "bands": [
        {"label": "normal", "min": 0, "max": 30},
        {"label": "microalbuminuria", "min": 30, "max": 300},
        {"label": "macroalbuminuria", "min": 300, "max": null}
      ],
      "source": "General clinical laboratory reference"
    }
  },
  "risk_categories": {
    "description": "Maps predicted mortality probability to a simplified life-insurance underwriting decision. Thresholds are illustrative for this academic project.",
    "bands": [
      {"category": "Preferred", "min": 0.0, "max": 0.05, "action": "Approve at preferred (lowest) premium rates", "table_rating": "Preferred"},
      {"category": "Standard", "min": 0.05, "max": 0.15, "action": "Approve at standard premium rates", "table_rating": "Standard"},
      {"category": "Substandard", "min": 0.15, "max": 0.40, "action": "Approve with premium loading (higher rates)", "table_rating": "Table B-D"},
      {"category": "High Risk", "min": 0.40, "max": 0.70, "action": "Approve only with significant loading or refer to senior underwriter", "table_rating": "Table E-H"},
      {"category": "Decline", "min": 0.70, "max": 1.01, "action": "Decline or postpone; refer for medical review", "table_rating": "Decline"}
    ]
  }
}
